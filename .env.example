# LLM 配置（必填，支持 OpenAI 兼容接口）
LLM_API_KEY=your-api-key-here
# 阿里云 MaaS OpenAI 兼容示例：
# LLM_BASE_URL=https://<workspace>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://jeniya.top/v1
LLM_MODEL=gpt-4o

# Agent LLM（可选）
# false：全部 agent 走确定性规则。
# true：仅 Critic 对 AI 生成/低置信候选调用 LLM；Environment/Trigger 固定规则、不调 LLM。
# 正常 HTTP 路径会跳过整个 EnvironmentAgent；仅 --local-container 进入该节点。
# AGENT_LLM_MODEL 留空会复用 LLM_MODEL。
AGENT_LLM_ENABLED=false
AGENT_LLM_MODEL=

# HTTP/HTTPS 代理（可选，国内服务器访问外部 API 需配置）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
# 临时强制直连（忽略 HTTP_PROXY/HTTPS_PROXY），用于本地代理未启动时的批测
CVE_HUNTER_DISABLE_PROXY=false
NO_PROXY=localhost,127.0.0.1,<http2pcap-host>,<target-ip>,tinysnow.one
# LLM 调用在代码里强制直连(proxy=None)；搜索仍可用 HTTP(S)_PROXY

# NVD API Key（可选，有则提升请求配额）
NVD_API_KEY=

# Tavily 搜索 API Key（可选，不填则使用 DuckDuckGo 备用）
TAVILY_API_KEY=

# 公开来源检索；SearXNG 实例需启用 JSON 格式，未配置则使用 DuckDuckGo HTML。
SEARXNG_URL=
# 爬虫在总预算内并行启动付费和公开来源检索；Tavily 优先，未配置时使用 Brave。
# SEARCH_PAID_FALLBACK=false 禁用爬虫付费检索；均无密钥时仍可抓取公开资料。
BRAVE_SEARCH_API_KEY=
SEARCH_PAID_FALLBACK=true
# 有缓存 HTTP 片段时仍进行一次有界来源发现，补齐不同精确 endpoint。
REFERENCE_DISCOVERY_ENABLED=true

# http2pcap 服务地址（可选，不填则使用内置 httpx + scapy）
HTTP2PCAP_URL=

# 防火墙/IPS 检测接口（http2pcap 服务启用 check_ips 时使用）
IPS_API_URL=

# wayback-cve 服务地址（可选，不填则使用内置 httpx + trafilatura）
WAYBACK_URL=

# 目标 IP/端口（PoC 验证发送目标；也可直接填写 http://IP:端口）
TARGET_IP=127.0.0.1
TARGET_PORT=

# 自动攻击环境（Docker/Vulhub）
# false 时只发现和记录环境候选；true 时会对命中的 compose 执行 pull/up -d。
AUTO_ENV_ENABLED=false
VULHUB_DIR=third_party/vulhub
REAPOC_DIR=third_party/reapoc
VULNERABILITY_POC_DIR=third_party/vulnerability-poc
METARGET_DIR=third_party/metarget
ENVIRONMENT_REPO_AUTO_CLONE=true
ENVIRONMENT_HEALTHCHECK_TIMEOUT=90
# true 时仅回收本次工作流成功启动的环境；不会停止预先存在的靶场。
ENVIRONMENT_AUTO_CLEANUP=true
# 测完是否删除该 CVE 环境镜像以释放磁盘（默认 true；DB 金标准镜像默认保留）
ENVIRONMENT_REMOVE_IMAGES_AFTER_RUN=true
ENVIRONMENT_PRESERVE_DB_IMAGES=true
# Metarget 会修改宿主机 Docker/Kubernetes/内核，仅在专用 Ubuntu 靶机中开启。
METARGET_EXECUTION_ENABLED=false
METARGET_TARGET_URL=
# Vulfocus 开放 API；三项均配置后才启用镜像发现和启动。
VULFOCUS_API_URL=
VULFOCUS_USERNAME=
VULFOCUS_LICENCE=
ATTACK_ENV_COMPOSE_FILE=
ATTACK_ENV_TARGET_URL=
CALLBACK_URL=

# 执行策略
# plan_only: 只做情报查询、环境规划、PoC 搜索/生成和报告归档，不真实发包；最安全，适合批量筛选。
# local_lab: 允许向本机、私有网段、host.docker.internal 或 TARGET_ALLOWLIST 命中的目标发包；适合 Vulhub/Docker 本地靶场。
# authorized_target: 只允许向 TARGET_ALLOWLIST 命中的目标发包；适合已经明确授权的远程目标。
RUN_MODE=plan_only
# RUN_MODE=local_lab 时，白名单是额外允许项；RUN_MODE=authorized_target 时，必须命中这里才会执行 PoC。
TARGET_ALLOWLIST=127.0.0.1,localhost
MAX_REQUESTS_PER_CVE=20
MAX_CANDIDATES_PER_CVE=50
# --local-container 时默认不远程搜索（仅 local_kb + 本地 nuclei），可改为 true 恢复旧行为
# LOCAL_CONTAINER_ALLOW_REMOTE_SEARCH=false
# local-container 下每 CVE 最大验证请求数
# LOCAL_CONTAINER_MAX_REQUESTS_PER_CVE=6

# 本地 PoC 知识库目录（含 trickest/cve submodule 和 custom/ 自定义 PoC）
POC_KB_DIR=poc_kb

# 本地 NVD 数据库目录（下载 NVD 年度 JSON Feed 到此目录）
NVD_LOCAL_DIR=poc_kb/nvd

# 输出目录
OUTPUT_DIR=output

# 测试抓包归档根目录（自动按 YYYY-MM-DD 分目录）
PCAP_OUTPUT_DIR=data/cve/pcaps
# 数据库非 HTTP 路径是否启用 dumpcap TCP 抓包（默认：RUN_MODE=local_lab 时开启）
# DB_TCP_CAPTURE_ENABLED=true
# dumpcap 路径 / 抓包网卡（Windows 本机库常用 Loopback）
# DUMPCAP_PATH=
# CAPTURE_INTERFACE=\Device\NPF_Loopback

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 每个 CVE 根引用、搜索与链接追踪的共享预算；默认及上限 60 秒；取得完整证据可提前结束；0 禁用联网读取
REFERENCE_CRAWL_BUDGET=60
# 单次 CVE 运行的模型调用上限；0 不限制。相同提示复用不计入调用次数。
LLM_MAX_CALLS_PER_CVE=12
LLM_TIMEOUT=60

# Web 工作台性能参数
# SSE 增量事件最多保留多少条，断线超过窗口会自动回退到完整快照
WEB_EVENT_BUFFER_SIZE=4096
# 任务快照合并写盘间隔（秒）；终态/取消仍会立即写盘
WEB_TASK_SAVE_INTERVAL=1.5
# 所有 Web 任务共享的最大活动 CVE 数，避免多个任务叠加打满主机
WEB_MAX_ACTIVE_CVES=16
# 外部参考/PoC 源的单请求超时（秒），NVD 与目标验证仍使用 REQUEST_TIMEOUT
WEB_SOURCE_TIMEOUT=12

# 本地 nuclei 可执行文件路径（供 local_http2pcap_service /api/nuclei-poc 使用）
NUCLEI_PATH=
